# STEP 3: BUILDING REGRESSION MODELS                                                                                                          
# =============================================================================                                                               

# -----------------------------------------------------------------------------                                                               
# 3.1 Simple linear regressions (one predictor at a time)                                                                                     
# -----------------------------------------------------------------------------                                                               

# Quantitative predictors                                                                                                                     
m_age    <- lm(y ~ age, data = data_clean)                                                                                                    
m_study  <- lm(y ~ study_hrs, data = data_clean)                                                                                              
m_sleep  <- lm(y ~ sleep_hrs, data = data_clean)                                                                                              
m_attend <- lm(y ~ attend_pct, data = data_clean)                                                                                             

# Categorical predictors                                                                                                                      
m_sexe      <- lm(y ~ sexe, data = data_clean)                                                                                                
m_school    <- lm(y ~ school_type, data = data_clean)                                                                                         
m_parent    <- lm(y ~ parent_educ, data = data_clean)                                                                                         
m_sleepqual <- lm(y ~ sleep_qual, data = data_clean)                                                                                          
m_trav      <- lm(y ~ trav_time, data = data_clean)                                                                                           
m_extra     <- lm(y ~ extra_act, data = data_clean)                                                                                           
m_web       <- lm(y ~ web_access, data = data_clean)                                                                                          
m_method    <- lm(y ~ study_method, data = data_clean)                                                                                        

# AJOUT : Summary table of all simple regressions (R² comparison)                                                                             
simple_models <- list(                                                                                                                        
  attend_pct = m_attend, study_hrs = m_study, sleep_hrs = m_sleep, age = m_age,                                                               
  parent_educ = m_parent, sleep_qual = m_sleepqual, trav_time = m_trav,                                                                       
  school_type = m_school, web_access = m_web, extra_act = m_extra,                                                                            
  study_method = m_method, sexe = m_sexe                                                                                                      
)                                                                                                                                             

simple_reg_table <- data.frame(                                                                                                               
  Predictor = names(simple_models),                                                                                                           
  R2 = round(sapply(simple_models, function(m) summary(m)$r.squared), 4),                                                                     
  Adj_R2 = round(sapply(simple_models, function(m) summary(m)$adj.r.squared), 4)                                                              
)                                                                                                                                             
simple_reg_table <- simple_reg_table[order(-simple_reg_table$R2), ]                                                                           
simple_reg_table                                                                                                                              

# Display detailed summaries for top predictors                                                                                               
summary(m_attend)                                                                                                                             
summary(m_study)                                                                                                                              
summary(m_parent)                                                                                                                             
summary(m_sleepqual)                                                                                                                          
summary(m_trav)                                                                                                                               

# Simple regressions confirm that attendance rate, study hours,                                                                               
# parental education, sleep quality and travel time are strong predictors.                                                                    
# sexe shows very low R² (< 0.01) and is not significant → excluded from models.                                                              
# These results motivate the multivariate model.                                                                                              

# -----------------------------------------------------------------------------                                                               
# 3.2 Multiple linear regression models with a justified set of predictors                                                                    
# -----------------------------------------------------------------------------                                                               

# Predictor selection justification (based on EDA and simple regressions):                                                                    
# - attend_pct: strongest predictor (R² ≈ 0.55)                                                                                               
# - study_hrs: moderate predictor (R² ≈ 0.32)                                                                                                 
# - parent_educ, sleep_qual, trav_time: significant ordinal predictors                                                                        
# - school_type, web_access: significant categorical predictors                                                                               
# - extra_act, study_method: included in extended model                                                                                       
# - age, sleep_hrs: quantitative controls                                                                                                     
# - sexe: EXCLUDED (very weak association, R² < 0.01, not significant)                                                                        

# Model 0: Baseline with quantitative predictors only                                                                                         
mod0 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs, data = data_clean)                                                                   

# Model 1: Add key categorical/ordinal predictors supported by EDA                                                                            
mod1 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +                                                                                     
             parent_educ + sleep_qual + trav_time +                                                                                           
             school_type + web_access,                                                                                                        
           data = data_clean)                                                                                                                 

# Model 2: Add extra_act and study_method                                                                                                     
mod2 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +                                                                                     
             parent_educ + sleep_qual + trav_time +                                                                                           
             school_type + web_access +                                                                                                       
             extra_act + study_method,                                                                                                        
           data = data_clean)                                                                                                                 

# Model 3: Test ONE interaction hypothesis                                                                                                    
# Hypothesis: The effect of study hours on exam score may depend on attendance rate.                                                          
# Students who attend more classes may benefit more from additional study hours.                                                              
mod3 <- lm(y ~ attend_pct * study_hrs + age + sleep_hrs +                                                                                     
             parent_educ + sleep_qual + trav_time +                                                                                           
             school_type + web_access,                                                                                                        
           data = data_clean)                                                                                                                 

# -----------------------------------------------------------------------------                                                               
# 3.3 Consider transformations                                                                                                                
# -----------------------------------------------------------------------------                                                               

# We considered possible transformations or re-expressions of the response and                                                                
# predictors based on the exploratory analysis and model diagnostics. However,                                                                
# simple regressions and residual plots do not reveal strong nonlinearity,                                                                    
# skewness, or heteroskedasticity. Therefore, no transformation is justified,                                                                 
# and we retain the original scale of the variables to preserve interpretability.                                                             

# -----------------------------------------------------------------------------                                                               
# 3.4 Test interaction hypothesis                                                                                                             
# -----------------------------------------------------------------------------                                                               

# Test whether adding the interaction improves the model (nested within mod1)                                                                 
anova(mod1, mod3)                                                                                                                             

# The interaction term attend_pct:study_hrs is not statistically significant (p ≈ 0.11).                                                      
# In line with parsimony, we do not retain interaction terms.                                                                                 

# -----------------------------------------------------------------------------                                                               
# 3.5 Check multicollinearity (VIF)                                                                                                           
# -----------------------------------------------------------------------------                                                               

library(car)                                                                                                                                  

# VIF for mod2 (final model candidate)                                                                                                        
vif(mod2)                                                                                                                                     

# Interpretation:                                                                                                                             
# - VIF < 5: no problematic multicollinearity                                                                                                 
# - VIF 5-10: moderate concern                                                                                                                
# - VIF > 10: high multicollinearity                                                                                                          
# For factors, use GVIF^(1/(2*Df)) which should be < 2.5                                                                                      

# -----------------------------------------------------------------------------                                                               
# 3.6 Model comparison and final choice                                                                                                       
# -----------------------------------------------------------------------------                                                               

