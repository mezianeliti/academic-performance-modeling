pred1 <- predict(final_model, newdata = profile1, interval = "confidence")
pred2 <- predict(final_model, newdata = profile2, interval = "confidence")

cat("High-performing student predicted score:", round(pred1[1], 1),
    "[", round(pred1[2], 1), ",", round(pred1[3], 1), "]\n")
