## Predictive Performance

### Train/Test Split

```{r}
#| label: train-test-split

set.seed(42)
n <- nrow(data_clean)
idx_train <- sample(seq_len(n), size = 0.8 * n)
train <- data_clean[idx_train, ]
test <- data_clean[-idx_train, ]

cat("Training set:", nrow(train), "observations\n")
cat("Test set:", nrow(test), "observations\n")
```

### Model Performance

```{r}
#| label: performance-metrics

mod2_tr <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
                parent_educ + sleep_qual + trav_time +
                school_type + web_access +
                extra_act + study_method, data = train)

pred2 <- predict(mod2_tr, newdata = test)
y_mean <- mean(train$y)
pred_base <- rep(y_mean, nrow(test))

mse <- function(y, yhat) mean((y - yhat)^2)
rmse <- function(y, yhat) sqrt(mean((y - yhat)^2))
r2_oos <- function(y, yhat) 1 - sum((y - yhat)^2) / sum((y - mean(y))^2)
medae <- function(y, yhat) median(abs(y - yhat))

perf <- data.frame(
  Model = c("Baseline", "Final model"),
  MSE = c(mse(test$y, pred_base), mse(test$y, pred2)),
  RMSE = c(rmse(test$y, pred_base), rmse(test$y, pred2)),
  R2_test = c(r2_oos(test$y, pred_base), r2_oos(test$y, pred2)),
  MedAE = c(medae(test$y, pred_base), medae(test$y, pred2))
)
perf
```

### Calibration Plot

```{r}
#| label: fig-calibration
#| fig-cap: "Calibration plot: predicted vs observed exam scores"

calib_df <- data.frame(observed = test$y, predicted = pred2)

ggplot(calib_df, aes(x = observed, y = predicted)) +
  geom_point(alpha = 0.3) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "red") +
