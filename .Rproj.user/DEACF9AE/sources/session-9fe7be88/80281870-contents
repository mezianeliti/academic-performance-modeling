# -----------------------------------------------------------------------------
# 6.1 Train/test split
# -----------------------------------------------------------------------------

set.seed(42)

n <- nrow(data_clean)
idx_train <- sample(seq_len(n), size = 0.8 * n)

train <- data_clean[idx_train, ]
test <- data_clean[-idx_train, ]

dim(train)
dim(test)

# -----------------------------------------------------------------------------
# 6.2 Refit models on training data only
# -----------------------------------------------------------------------------

mod1_tr <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
                parent_educ + sleep_qual + trav_time +
                school_type + web_access,
              data = train)

mod2_tr <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
                parent_educ + sleep_qual + trav_time +
                school_type + web_access +
                extra_act + study_method,
              data = train)

mod3_tr <- lm(y ~ attend_pct * study_hrs + age + sleep_hrs +
                parent_educ + sleep_qual + trav_time +
                school_type + web_access,
              data = train)

# -----------------------------------------------------------------------------
# 6.3 Predictions on test set
# -----------------------------------------------------------------------------

pred1 <- predict(mod1_tr, newdata = test)
pred2 <- predict(mod2_tr, newdata = test)
pred3 <- predict(mod3_tr, newdata = test)

y_mean <- mean(train$y)
pred_base <- rep(y_mean, nrow(test))

# -----------------------------------------------------------------------------
# 6.4 Performance metrics
# -----------------------------------------------------------------------------

mse <- function(y, yhat) mean((y - yhat)^2)
rmse <- function(y, yhat) sqrt(mean((y - yhat)^2))
r2_oos <- function(y, yhat) 1 - sum((y - yhat)^2) / sum((y - mean(y))^2)
medae <- function(y, yhat) median(abs(y - yhat))

# -----------------------------------------------------------------------------
# 6.5 Performance table
# -----------------------------------------------------------------------------

perf <- data.frame(
  Model = c("Baseline", "mod1", "mod2 (final)", "mod3"),
  MSE = c(mse(test$y, pred_base), mse(test$y, pred1),
          mse(test$y, pred2), mse(test$y, pred3)),
  RMSE = c(rmse(test$y, pred_base), rmse(test$y, pred1),
           rmse(test$y, pred2), rmse(test$y, pred3)),
  R2_test = c(r2_oos(test$y, pred_base), r2_oos(test$y, pred1),
              r2_oos(test$y, pred2), r2_oos(test$y, pred3)),
  MedAE = c(medae(test$y, pred_base), medae(test$y, pred1),
            medae(test$y, pred2), medae(test$y, pred3))
)

perf

# -----------------------------------------------------------------------------
# 6.6 Improvement over baseline
# -----------------------------------------------------------------------------

baseline_mse <- perf$MSE[perf$Model == "Baseline"]
perf$MSE_reduction_pct <- round(100 * (baseline_mse - perf$MSE) / baseline_mse, 1)
perf

