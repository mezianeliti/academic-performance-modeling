# 1.3 Variable preparation
# -----------------------------------------------------------------------------

# We keep continuous versions (age, attend_pct) because:
# - They preserve more information than categorical versions
# - Coefficients are directly interpretable
# - EDA shows approximately linear relationships with y
# We remove agecat and attend_pct_cat to avoid multicollinearity

# Labels match the codebook exactly
# For ordinal variables, we use ordered = FALSE to get treatment contrasts

data_clean <- data_raw %>%
  mutate(
    sexe = factor(sexe,
                  levels = c(1, 2, 3),
                  labels = c("Female", "Male", "Other")),

    school_type = factor(school_type,
                         levels = c(1, 2),
                         labels = c("Public", "Private")),

    parent_educ = factor(parent_educ,
                         levels = 1:6,
                         labels = c("No Formal", "High School", "Graduate",
                                    "Post Graduate 1", "Post Graduate 2", "PHD"),
                         ordered = FALSE),

    sleep_qual = factor(sleep_qual,
                        levels = c(1, 2, 3),
                        labels = c("Poor", "Average", "Good"),
                        ordered = FALSE),

    web_access = factor(web_access,
                        levels = c(1, 2),
                        labels = c("No", "Yes")),

    trav_time = factor(trav_time,
                       levels = c(1, 2, 3, 4),
                       labels = c("<15 Min", "15-30 Min", "30-60 Min", ">60 Min"),
                       ordered = FALSE),

    extra_act = factor(extra_act,
                       levels = c(1, 2),
                       labels = c("No", "Yes")),

    study_method = factor(study_method,
                          levels = 1:6,
                          labels = c("Online Videos", "Coaching", "Notes",
                                     "Textbook", "Group Study", "Mixed"))
  ) %>%
  select(-agecat, -attend_pct_cat)

# -----------------------------------------------------------------------------
# 1.4 Set reference categories explicitly
# -----------------------------------------------------------------------------

data_clean <- data_clean %>%
  mutate(
    sexe = relevel(sexe, ref = "Female"),
    school_type = relevel(school_type, ref = "Public"),
    parent_educ = relevel(parent_educ, ref = "No Formal"),
    sleep_qual = relevel(sleep_qual, ref = "Poor"),
    web_access = relevel(web_access, ref = "No"),
    trav_time = relevel(trav_time, ref = "<15 Min"),
    extra_act = relevel(extra_act, ref = "No"),
    study_method = relevel(study_method, ref = "Online Videos")
  )

