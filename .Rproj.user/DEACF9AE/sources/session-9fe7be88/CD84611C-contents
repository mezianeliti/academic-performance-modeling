# Function to display counts and proportions                                                                                                  
freq_table <- function(var) {                                                                                                                 
  tab <- table(var)                                                                                                                           
  prop <- prop.table(tab)                                                                                                                     
  data.frame(                                                                                                                                 
    Level = names(tab),                                                                                                                       
    Count = as.integer(tab),                                                                                                                  
    Proportion = round(as.numeric(prop), 3)                                                                                                   
  )                                                                                                                                           
}                                                                                                                                             

