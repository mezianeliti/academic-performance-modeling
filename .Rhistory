}
data_raw <- read.csv("data/project.csv")
dim(data_raw)
str(data_raw)
# 2) Integrity checks
any(duplicated(data_raw$id))
summary(data_raw)
# 3) Variable preparation
data_clean <- data_raw %>%
mutate(
sexe = factor(sexe,
levels = c(1, 2, 3),
labels = c("Female", "Male", "Other")),
school_type = factor(school_type,
levels = c(1, 2),
labels = c("Public", "Private")),
parent_educ = factor(parent_educ,
levels = 1:6,
labels = c("No formal",
"High school",
"Graduate",
"Post graduate 1",
"Post graduate 2",
"PhD"),
ordered = TRUE),
sleep_qual = factor(sleep_qual,
levels = c(1, 2, 3),
labels = c("Poor", "Average", "Good"),
ordered = TRUE),
web_access = factor(web_access,
levels = c(1, 2),
labels = c("No", "Yes")),
trav_time = factor(trav_time,
levels = c(1, 2, 3, 4),
labels = c("<15 min", "15–30 min", "30–60 min", ">60 min"),
ordered = TRUE),
extra_act = factor(extra_act,
levels = c(1, 2),
labels = c("No", "Yes")),
study_method = factor(study_method,
levels = 1:6,
labels = c("Online videos",
"Coaching",
"Notes",
"Textbook",
"Group study",
"Mixed"))
) %>%
select(-agecat, -attend_pct_cat)
# 4) Final check
