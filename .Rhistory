geom_boxplot(fill = "dodgerblue", color = "black") +
labs(x = "Study method", y = "Residuals") +
theme_bw(base_size = 14) +
labs_pubr()
select(data_clean, y, age, study_hrs, sleep_hrs, attend_pct) |>
collapse::descr(Qprobs = c(0.25, 0.5, 0.75)) |>
as_tibble()
## Simple regressions confirm that attendance rate, study hours,
# parental education, sleep quality and travel time are strong predictors.
# These results motivate the multivariate model.
#À METTRE DANS LE RAPPORT
# We first estimate simple linear regressions (one predictor at a time) to describe baseline associations. Attendance rate shows a very strong positive association with exam score (R² ≈ 0.55), making it the strongest single predictor. Study hours is also positively related to performance. For categorical variables, parental education, sleep quality, and travel time are clearly associated with exam score (higher parental education and better sleep quality correspond to higher scores, while longer travel time corresponds to lower scores). These results confirm the EDA patterns and motivate the predictors included in the multivariate model.
#3.2: multiple linear regression models with a justified set of predictors
mod0 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs, data = data_clean)
# Model 1: add key categorical/ordinal predictors supported by EDA
mod1 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = data_clean)
# Model 2: add a small number of motivated extra terms (optional)
mod2 <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access +
extra_act + study_method,
data = data_clean)
# Model 3: test ONE interaction hypothesis
# Hypothesis: effect of study_hrs depends on attend_pct (or vice-versa)
mod3 <- lm(y ~ attend_pct * study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = data_clean)
# Test whether adding the interaction improves the model (nested within mod1)
anova(mod1, mod3) |> as.data.frame()
# Comment:
# The interaction term attend_pct:study_hrs is not statistically significant (p ≈ 0.11).
# In line with parsimony, we do not retain interaction terms, and we keep mod2 as final
# We considered possible transformations or re-expressions of the response and predictors based on the exploratory analysis and model diagnostics. However, simple regressions and residual plots do not reveal strong nonlinearity, skewness, or heteroskedasticity. Therefore, no transformation is justified, and we retain the original scale of the variables to preserve interpretability.
#Hypothesis:
# The effect of study hours on exam score may depend on attendance rate.
# Students who attend more classes may benefit more from additional study hours.
# 3.5 Model comparison and final choice
library(performance)
library(dplyr)
# Short model-selection table (Adj R2, AIC, BIC)
tab_models <- bind_rows(
model_performance(mod0) |> mutate(Model = "mod0"),
model_performance(mod1) |> mutate(Model = "mod1"),
model_performance(mod2) |> mutate(Model = "mod2"),
model_performance(mod3) |> mutate(Model = "mod3")
) |>
select(Model, R2_adjusted, AIC, BIC) |>
arrange(AIC)
tab_models
# Nested F-tests (inferential criterion)
ftests <- bind_rows(
anova(mod0, mod1) |> as.data.frame() |> mutate(Comparison = "mod0 vs mod1"),
anova(mod1, mod2) |> as.data.frame() |> mutate(Comparison = "mod1 vs mod2"),
anova(mod1, mod3) |> as.data.frame() |> mutate(Comparison = "mod1 vs mod3")
) |>
filter(!is.na(`Pr(>F)`)) |>
select(Comparison, Df, F, `Pr(>F)`)
ftests
set.seed(42)
n <- nrow(data_clean)
idx_train <- sample(seq_len(n), size = 0.8 * n)
train <- data_clean[idx_train, ]
test  <- data_clean[-idx_train, ]
dim(train)
dim(test)
set.seed(42)
n <- nrow(data_clean)
idx_train <- sample(seq_len(n), size = 0.8 * n)
train <- data_clean[idx_train, ]
test  <- data_clean[-idx_train, ]
dim(train)
dim(test)
mod1_tr <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = train)
mod2_tr <- lm(y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access +
extra_act + study_method,
data = train)
mod3_tr <- lm(y ~ attend_pct * study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = train)
#predict on new students
pred1 <- predict(mod1_tr, newdata = test)
pred2 <- predict(mod2_tr, newdata = test)  # modèle final
pred3 <- predict(mod3_tr, newdata = test)
#baseline model
y_mean <- mean(train$y)
pred_base <- rep(y_mean, nrow(test))
rmse <- function(y, yhat) sqrt(mean((y - yhat)^2))
r2_oos <- function(y, yhat) {
1 - sum((y - yhat)^2) / sum((y - mean(y))^2)
}
medae <- function(y, yhat) median(abs(y - yhat))
library(tibble)
perf <- tibble(
Model = c("Baseline", "mod1", "mod2 (final)", "mod3"),
RMSE = c(
rmse(test$y, pred_base),
rmse(test$y, pred1),
rmse(test$y, pred2),
rmse(test$y, pred3)
),
R2_test = c(
r2_oos(test$y, pred_base),
r2_oos(test$y, pred1),
r2_oos(test$y, pred2),
r2_oos(test$y, pred3)
),
MedAE = c(
medae(test$y, pred_base),
medae(test$y, pred1),
medae(test$y, pred2),
medae(test$y, pred3)
)
)
perf
plot(test$y, pred2,
xlab = "Observed exam score",
ylab = "Predicted exam score",
main = "Calibration plot – Final model (mod2)")
abline(0, 1, col = "red", lwd = 2)
# 6) Predictive performance (train / test)
#6.1 Train / test split (reproducible)
set.seed(42)
n <- nrow(data_clean)
idx_train <- sample(seq_len(n), size = 0.8 * n)
train <- data_clean[idx_train, ]
test  <- data_clean[-idx_train, ]
dim(train)
dim(test)
#6.2 Refit candidate models on TRAIN only
mod1_tr <- lm(
y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = train
)
mod2_tr <- lm(
y ~ attend_pct + study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access +
extra_act + study_method,
data = train
)
mod3_tr <- lm(
y ~ attend_pct * study_hrs + age + sleep_hrs +
parent_educ + sleep_qual + trav_time +
school_type + web_access,
data = train
)
# 6.3 Predict on TEST (unseen "new students")
pred1 <- predict(mod1_tr, newdata = test)
pred2 <- predict(mod2_tr, newdata = test)  # final model
pred3 <- predict(mod3_tr, newdata = test)
# 6.4 Baseline model: predict training mean of y
y_mean <- mean(train$y)
pred_base <- rep(y_mean, nrow(test))
#  6.5 Metrics (MSE required + RMSE, R2_test, MedAE)
mse <- function(y, yhat) mean((y - yhat)^2)
rmse <- function(y, yhat) sqrt(mean((y - yhat)^2))
# out-of-sample R^2 computed on test set
r2_oos <- function(y, yhat) {
1 - sum((y - yhat)^2) / sum((y - mean(y))^2)
}
medae <- function(y, yhat) median(abs(y - yhat))
#6.6 Performance table (same protocol for all models)
perf <- tibble(
Model = c("Baseline", "mod1", "mod2 (final)", "mod3"),
MSE = c(
mse(test$y, pred_base),
mse(test$y, pred1),
mse(test$y, pred2),
mse(test$y, pred3)
),
RMSE = c(
rmse(test$y, pred_base),
rmse(test$y, pred1),
rmse(test$y, pred2),
rmse(test$y, pred3)
),
R2_test = c(
r2_oos(test$y, pred_base),
r2_oos(test$y, pred1),
r2_oos(test$y, pred2),
r2_oos(test$y, pred3)
),
MedAE = c(
medae(test$y, pred_base),
medae(test$y, pred1),
medae(test$y, pred2),
medae(test$y, pred3)
)
)
perf
#  6.7 Improvement over baseline
baseline_mse  <- perf$MSE[perf$Model == "Baseline"]
baseline_rmse <- perf$RMSE[perf$Model == "Baseline"]
perf_improve <- perf %>%
mutate(
MSE_gain = baseline_mse - MSE,                       # >0 means better than baseline
MSE_gain_pct = 100 * (baseline_mse - MSE) / baseline_mse,
RMSE_gain = baseline_rmse - RMSE,                    # >0 means better than baseline
RMSE_gain_pct = 100 * (baseline_rmse - RMSE) / baseline_rmse
)
perf_improve
perf_improve %>%
select(Model, MSE, RMSE, R2_test, MedAE, RMSE_gain_pct)
#6.8 Calibration check (predicted vs observed) final model
calib_df <- tibble(
observed  = test$y,
predicted = pred2
)
ggplot(calib_df, aes(x = observed, y = predicted)) +
geom_point(alpha = 0.35) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = "Calibration plot – Final model (mod2)",
subtitle = paste0("Test set (n = ", nrow(test), ")"),
x = "Observed exam score",
y = "Predicted exam score"
) +
theme_bw()
head(tibble(
observed = test$y,
pred_mod2 = pred2
))
getwd()
list.files("data")
